# MicoHunter — repositorio solo con lo necesario para que la web funcione.
# Lista blanca: se ignora todo y se incluye solo lo imprescindible.
*
!*/
!.gitignore

# --- Código de la web ---
!index.html
!app.js
!cotos.js
!cotos_poly.js
!mup_extra.js
!pnsg_res.js
!styles.css
!dark.css
!musgo.css

# --- Imágenes realmente referenciadas por la web ---
!img/
!img/edulis.png
!img/boletus.jpg
!img/niscalo.webp
!img/oronja.webp
!img/chantarela.webp
